# Copy this file to .env and fill in real values. .env is gitignored.

# --- Connectors ---
NHS_JOBS_MIN_INTERVAL_SECONDS=3
TRAC_MIN_INTERVAL_SECONDS=5
POLL_INTERVAL_SECONDS=14400

# Adzuna: free signup at https://developer.adzuna.com — free tier is capped at
# 25 req/min AND 250 req/day; ADZUNA_DAILY_CAP is enforced locally so polling
# stops before the API itself throttles/suspends the key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MIN_INTERVAL_SECONDS=3
ADZUNA_DAILY_CAP=250

# Reed: free signup at https://www.reed.co.uk/developers
REED_API_KEY=
REED_MIN_INTERVAL_SECONDS=1

# Smart search: expands a keyword into related job titles (e.g. "support" ->
# "Care Assistant", "Healthcare Assistant") via the configured LLM. Needs
# ANTHROPIC_API_KEY/OPENAI_API_KEY above; degrades to literal-keyword-only
# search if no key is set.
QUERY_EXPANSION_MAX_TERMS=3

# Visa sponsorship: cross-checks every job's employer against the UK Home
# Office's public register of licensed visa sponsors (no key needed, free,
# open data). Cached locally at data/sponsor_register.csv, re-downloaded
# once it's older than this many days.
SPONSOR_REGISTER_MAX_AGE_DAYS=7

# --- Database ---
DATABASE_PATH=data/jobs.db

# --- Tailoring / LLM ---
# anthropic or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

PROFILE_PATH=data/profile.yaml

# --- Notifier (optional, mirrors visa-bot) ---
NOTIFY_EMAIL=
GMAIL_APP_PASSWORD=

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
